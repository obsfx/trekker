{
  "name": "@obsfx/trekker",
  "version": "1.11.0",
  "description": "A CLI-based issue tracker built for AI coding agents. Stores tasks, epics, and dependencies in a local SQLite database.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "trekker": "bin/trekker.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external commander --external drizzle-orm",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:container": "bun tests/container/run.ts",
    "test:release": "bun run check && bun run typecheck && bun test && bun run test:container",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit && tsc -p scripts --noEmit",
    "check": "bun run lint && bun run format:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "release": "bun scripts/release.ts"
  },
  "keywords": [
    "cli",
    "issue-tracker",
    "task-management",
    "sqlite",
    "ai-agents",
    "coding-agents",
    "project-management",
    "todo",
    "epic",
    "bun"
  ],
  "author": "Omercan Balandi <balandiomer@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/obsfx/trekker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsfx/trekker.git"
  },
  "bugs": {
    "url": "https://github.com/obsfx/trekker/issues"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@toon-format/toon": "2.1.0",
    "commander": "13.1.0",
    "dayjs": "1.11.19",
    "drizzle-orm": "0.38.4"
  },
  "devDependencies": {
    "@types/bun": "1.2.2",
    "drizzle-kit": "0.30.4",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unicorn": "63.0.0",
    "knip": "6.3.1",
    "prettier": "3.8.1",
    "testcontainers": "12.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.56.1"
  }
}
