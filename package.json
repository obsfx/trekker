{
  "name": "@obsfx/trekker",
  "version": "1.12.0",
  "description": "A CLI-based issue tracker built for AI coding agents. Stores tasks, epics, and dependencies in a local SQLite database.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "trekker": "bin/trekker.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "bun run build:ui && bun run build:cli",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:container": "bun tests/container/run.ts",
    "test:release": "bun run check && bun run typecheck && bun test && bun run test:ui && bun run test:e2e && bun run test:container",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"ui/**/*.{ts,tsx,css}\" \".storybook/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"ui/**/*.{ts,tsx,css}\" \".storybook/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit && tsc -p scripts --noEmit && tsc -p ui --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "check": "bun run lint && bun run format:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "release": "bun scripts/release.ts",
    "dev:ui": "vite",
    "dev:server": "cd ${TREKKER_DEV_DIR:-../trekker-sandbox} && bun --watch $OLDPWD/src/index.ts serve --port 4400 --dev",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build:ui": "vite build --mode embed",
    "build:cli": "bun build src/index.ts --outdir dist --target bun --external commander --external drizzle-orm",
    "test:ui": "vitest run",
    "test:ui:unit": "vitest run --project ui-unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "bun run build:ui && playwright test -c tests/e2e/playwright.config.ts"
  },
  "keywords": [
    "cli",
    "issue-tracker",
    "task-management",
    "sqlite",
    "ai-agents",
    "coding-agents",
    "project-management",
    "todo",
    "epic",
    "bun"
  ],
  "author": "Omercan Balandi <balandiomer@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/obsfx/trekker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsfx/trekker.git"
  },
  "bugs": {
    "url": "https://github.com/obsfx/trekker/issues"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.2.3"
  },
  "dependencies": {
    "@toon-format/toon": "2.1.0",
    "commander": "13.1.0",
    "dayjs": "1.11.19",
    "drizzle-orm": "0.38.4",
    "fractional-indexing": "4.0.0",
    "plur": "6.0.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@babel/core": "7.29.7",
    "@base-ui/react": "1.9.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/google-sans-code": "5.3.2",
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.22",
    "@types/bun": "1.3.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uidotdev/usehooks": "2.4.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "2.1.1",
    "drizzle-kit": "0.30.4",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.3",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "17.13.0",
    "knip": "6.3.1",
    "playwright": "1.64.1",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  }
}
